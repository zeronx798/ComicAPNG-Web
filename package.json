{
  "name": "comicapng-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:core": "vitest run tests/core",
    "prepare:e2e": "playwright install chromium firefox webkit",
    "test:e2e": "playwright test",
    "validate:source": "node scripts/source-policy.mjs",
    "validate:env": "node scripts/environment.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "validate:pwa": "node scripts/validate-build.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "dependencies": {
    "apng-js": "1.1.5",
    "fflate": "0.8.3",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
